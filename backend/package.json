{
  "name": "CAREBackend",
  "version": "1.1.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "db_create": "cd db && npx sequelize-cli db:create",
    "db_migrate": "cd db && npx sequelize-cli db:migrate",
    "db_migrate:reset": "cd db && npx sequelize-cli db:drop && npm run db_create && npm run db_migrate",
    "db_migrate:reset2": "cd db && npm run db_create || echo \"IGNORING ERROR\" && npx sequelize-cli db:migrate:undo:all && npm run db_migrate",
    "test": "cross-env NODE_ENV=test DISABLE_LOGGING=false jest --silent=false --forceExit --testTimeout=10000 --runInBand --collect-coverage -- test.js",
    "test_rpc": "cross-env NODE_ENV=test DISABLE_LOGGING=false jest --silent=false --forceExit --testTimeout=10000  --runInBand  --testPathPattern=tests/rpcs -- ",
    "test_doh": "cross-env NODE_ENV=test jest  --detectOpenHandles --testTimeout=10000",
    "pretest": "cross-env NODE_ENV=test npm run db_migrate:reset",
    "set-admin-password": "node scripts/setAdminPassword.js"
  },
  "dependencies": {
    "argparse": "^2.0.1",
    "axios": "^1.13.6",
    "axios-oauth-client": "^2.2.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.2",
    "connect-ensure-login": "^0.1.1",
    "connect-session-sequelize": "^8.0.5",
    "cors": "^2.8.6",
    "dayjs": "^1.11.19",
    "dotenv": "^17.3.1",
    "editor-delta-conversion": "file:../utils/modules/editor-delta-conversion",
    "express": "^5.2.1",
    "express-fileupload": "^1.5.2",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.19.0",
    "js-yaml": "^4.1.1",
    "mustache-express": "^1.3.2",
    "nodemailer": "^8.0.1",
    "objects-to-csv": "^1.3.6",
    "otpauth": "^9.2.2",
    "passport": "^0.7.0",
    "passport-ldapauth": "^3.0.1",
    "passport-local": "^1.0.0",
    "passport-orcid": "^0.0.4",
    "@node-saml/passport-saml": "^5.1.0",
    "pg-promise": "^12.1.3",
    "quill-delta": "^5.1.0",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.5",
    "sequelize-mock": "^0.10.2",
    "sequelize-simple-cache": "^1.3.5",
    "session-file-store": "^1.5.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "string-replace-middleware": "^1.1.0",
    "supertest": "^7.2.2",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "winston-transport": "^4.9.0",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.2.0"
  }
}
